# 🌍 App Config
BASE_URL=http://localhost:2424                 # e.g. http://localhost:2424 or https://api.example.com
ROUTE_PREFIX=/api/fileuploader      # e.g. /api/fileuploader

# 📦 Storage (S3 / MinIO / Compatible)
STORAGE_ENDPOINT=http://localhost:9000         # e.g. http://minio.example.com:9000 or https://s3.amazonaws.com
STORAGE_ACCESS_KEY=admin     # e.g. admin
STORAGE_SECRET_KEY=admin123     # e.g. strongpassword123
STORAGE_BUCKET=fileuploads
USE_BUCKET_STORAGE=false        # Set to true to enable S3/MinIO bucket storage

# Application Configuration
# Note: BASE_FOLDER removed - app uses S3 storage only

# Security Configuration
ENCRYPTION_KEY=your-secret-encryption-key-here

# Observability Configuration
# Enable Prometheus metrics (requires: pip install prometheus-client)
USE_PROMETHEUS=false

# Enable Loki structured logging for Promtail compatibility
USE_LOKI=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s     # e.g. strongpassword123
# For development
FLASK_DEBUG=true
# For testing
TESTING=true